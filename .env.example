# aistudio-api 环境变量配置
# 复制此文件为 .env 并按需修改

# ========== 服务基础配置 ==========
# HTTP 服务监听端口
AISTUDIO_PORT=8080
# Docker host binding (publishes only localhost unless explicitly changed)
AISTUDIO_BIND_ADDRESS=127.0.0.1
# Web 管理控制台访问密码（设置后访问 / 自动启用登录拦截）
AISTUDIO_WEB_PASSWORD=
# AISTUDIO_ADMIN_PASSWORD=

# ========== 网络代理与凭据 ==========
# HTTP / SOCKS5 出口代理（如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080）
AISTUDIO_PROXY=
# 以下可选路径未设置时使用应用或镜像默认值；Docker 中填写容器内路径
# 主数据持久化根目录（默认 data/，Docker 为 /app/data）
# AISTUDIO_DATA_DIR=
# 账号凭据存储目录（留空默认使用 data/accounts）
# AISTUDIO_ACCOUNTS_DIR=
# 模型调用与 Token 使用量统计持久化文件（留空默认使用 data/stats.json）
# AISTUDIO_STATS_FILE=
# 账号调度与 429 冷却状态持久化文件（留空默认使用 data/rotator_state.json）
# AISTUDIO_ROTATOR_STATE_FILE=
# 自定义 config.yaml 配置文件路径（默认项目根目录 config.yaml，Docker 为 /app/data/config.yaml）
# AISTUDIO_CONFIG_FILE=
# 认证文件路径（可选，单文件调试或导入时覆盖使用）
# AISTUDIO_AUTH_FILE=
# 是否持久化模型调用与 Token 统计（1=开启，0=关闭）
AISTUDIO_PERSIST_STATS=1
# 是否持久化账号调度与 429 冷却状态（1=开启，0=关闭）
AISTUDIO_PERSIST_ROTATOR=1
# 临时文件目录（留空自动获取系统临时目录）
# AISTUDIO_TMP_DIR=
# WAA node selection is in config.yaml; default local signer shares WARP egress.
# AISTUDIO_PROOF_SERVER_URL=http://127.0.0.1:8081

# ========== 模型默认行为 ==========
AISTUDIO_DEFAULT_TEXT_MODEL=gemini-3.7-flash

# ========== 调试与报文转储 ==========
# 是否在终端转储每次 API 请求与响应报文详情（1=开启，0=关闭，亦支持 DEBUG=1）
AISTUDIO_DUMP_REQUESTS=0
# 是否将请求与响应转储持久化保存为独立文件（1=开启，0=关闭）
AISTUDIO_DUMP_FILE=0
# 转储文件保存目录（留空默认使用 dumps/）
# AISTUDIO_DUMP_DIR=
# Embedded WARP is enabled by default. No root, TUN, or NET_ADMIN required.
# Initial device registration + release downloads use the existing network;
# account probes, local WAA signing, cookie rotation and inference use WARP.
AISTUDIO_WARP_ENABLED=1
AISTUDIO_WARP_PORT=1080
AISTUDIO_WARP_START_TIMEOUT=60
# Existing WireGuard/WARP profile (optional; skips automatic registration).
# AISTUDIO_WARP_PROFILE=/absolute/path/to/wgcf-profile.conf
# Override if the network blocks the default UDP endpoint.
# AISTUDIO_WARP_ENDPOINT=162.159.192.1:2408
# An explicit AISTUDIO_PROXY overrides embedded WARP intentionally.
# To use direct egress, set AISTUDIO_WARP_ENABLED=0 and unset proxy variables.
